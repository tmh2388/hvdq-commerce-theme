<!doctype html>
<html {% if request.design_mode %}class="shopify-design-mode"{% endif %} lang="{{ request.locale.iso_code }}">
<head>
<link rel="icon" type="image/png" sizes="32x32" href="https://cdn.shopify.com/s/files/1/0722/3030/5871/files/ha-van-monogram-balance-transparent.png?v=1784193250">
<link rel="apple-touch-icon" href="https://cdn.shopify.com/s/files/1/0722/3030/5871/files/ha-van-monogram-balance-transparent.png?v=1784193250">
{% if settings.transition_to_main_product or settings.page_transition_enabled %}<link rel="expect" href="#MainContent" blocking="render" id="view-transition-render-blocker">{% endif %}
{% render 'meta-tags' %}{% render 'stylesheets' %}{% render 'fonts' %}{% render 'scripts' %}{% render 'theme-styles-variables' %}{% render 'color-palette' %}
{{ 'hvdq-model-03-commerce.css' | asset_url | stylesheet_tag }}
{{ 'ha-van-brand-system.css' | asset_url | stylesheet_tag }}
{{ 'ha-van-header-refinement.css' | asset_url | stylesheet_tag }}
{{ 'ha-van-content-pages.css' | asset_url | stylesheet_tag }}
<script type="application/ld+json">{"@context":"https://schema.org","@type":"Organization","name":"HA VAN","url":"https://havancraft.vn","logo":"https://cdn.shopify.com/s/files/1/0722/3030/5871/files/ha-van-header-logo-transparent.png?v=1784193226"}</script>
{% if request.design_mode %}{% render 'theme-editor' %}{% endif %}{{ content_for_header }}
</head>
<body class="template-{{ template.name | handle }} page-width-{{ settings.page_width }} card-hover-effect-{{ settings.card_hover_effect }}">
{% render 'skip-to-content-link', href: '#MainContent', text: 'accessibility.skip_to_text' %}{% render 'chat-drawer' %}
<div class="page-wrapper">
<div class="hv-header-sentinel" data-hv-header-sentinel aria-hidden="true"></div>
{% unless template.name == 'index' %}
<div class="hv-positioning-bar" data-hv-positioning aria-label="HA VAN brand positioning">
  <span>Born from Fire.</span><span class="hv-positioning-bar__sep" aria-hidden="true">·</span>
  <span>Refined by Craft.</span><span class="hv-positioning-bar__sep" aria-hidden="true">·</span>
  <span>Preserved through Time.</span>
</div>
<div id="header-group">{% sections 'header-group' %}</div>
{% endunless %}
<main id="MainContent" class="content-for-layout" role="main" data-page-transition-enabled="{{ settings.page_transition_enabled }}" data-product-transition="{{ settings.transition_to_main_product }}" data-template="{{ template }}">{{ content_for_layout }}</main>
{% unless template.name == 'index' %}<footer>{% sections 'footer-group' %}</footer>{% endunless %}
</div>
{% render 'cart-drawer', render_wrapper: true %}{% render 'theme-drawer' %}{% render 'search-modal' %}
{% if settings.quick_add or settings.mobile_quick_add %}{% render 'quick-add-modal' %}{% endif %}
<script>
(()=>{
  const createPositioningBar=()=>{
    const bar=document.createElement('div');
    bar.className='hv-positioning-bar';
    bar.dataset.hvPositioning='';
    bar.setAttribute('aria-label','HA VAN brand positioning');
    bar.innerHTML='<span>Born from Fire.</span><span class="hv-positioning-bar__sep" aria-hidden="true">·</span><span>Refined by Craft.</span><span class="hv-positioning-bar__sep" aria-hidden="true">·</span><span>Preserved through Time.</span>';
    return bar;
  };

  const homeHeader=document.querySelector('[data-hv-home-header],.hv__header');
  if(homeHeader && !document.querySelector('[data-hv-positioning]')){
    homeHeader.insertAdjacentElement('beforebegin',createPositioningBar());
  }

  const standardHeader=document.getElementById('header-group');
  const headers=[standardHeader,homeHeader].filter(Boolean);
  const positioningBars=[...document.querySelectorAll('[data-hv-positioning]')];
  const sentinel=document.querySelector('[data-hv-header-sentinel]');
  let compactState=null;
  let ticking=false;

  const readScrollTop=()=>Math.max(
    window.scrollY||0,
    window.pageYOffset||0,
    document.documentElement?.scrollTop||0,
    document.body?.scrollTop||0
  );

  const applyState=(compact)=>{
    if(compact===compactState)return;
    document.body.classList.toggle('hv-header-compact',compact);
    headers.forEach((header)=>header.classList.toggle('is-compact',compact));
    positioningBars.forEach((bar)=>bar.classList.toggle('is-hidden',compact));
    compactState=compact;
  };

  const updateHeader=()=>{
    applyState(readScrollTop()>24);
    ticking=false;
  };

  const requestUpdate=()=>{
    if(ticking)return;
    ticking=true;
    window.requestAnimationFrame(updateHeader);
  };

  window.addEventListener('scroll',requestUpdate,{passive:true});
  document.addEventListener('scroll',requestUpdate,{passive:true,capture:true});
  window.addEventListener('resize',requestUpdate,{passive:true});
  window.addEventListener('pageshow',requestUpdate);
  document.addEventListener('shopify:section:load',requestUpdate);

  if('IntersectionObserver' in window && sentinel){
    const observer=new IntersectionObserver((entries)=>{
      const entry=entries[0];
      if(readScrollTop()>4)applyState(!entry.isIntersecting||readScrollTop()>24);
      else applyState(false);
    },{root:null,threshold:0,rootMargin:'-24px 0px 0px 0px'});
    observer.observe(sentinel);
  }

  updateHeader();
})();
</script>
</body></html>