<!doctype html><html lang="{{ request.locale.iso_code }}" {% if request.design_mode %}class="shopify-design-mode"{% endif %}><head>{% if settings.favicon != blank %}<link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">{% else %}<link rel="icon" type="image/png" href="https://cdn.shopify.com/s/files/1/0722/3030/5871/files/ha-van-monogram-balance-clean-transparent.png?v=1784247614">{% endif %}{% render 'meta-tags' %}{% render 'stylesheets' %}{% render 'fonts' %}{% render 'scripts' %}{% render 'theme-styles-variables' %}{% render 'color-palette' %}{{ 'ha-van-global-system.css' | asset_url | stylesheet_tag }}{{ 'ha-van-commerce.css' | asset_url | stylesheet_tag }}{{ 'ha-van-brand-fixes.css' | asset_url | stylesheet_tag }}<script src="{{ 'ha-van-global-system.js' | asset_url }}" defer></script>{% if request.design_mode %}{% render 'theme-editor' %}{% endif %}{{ content_for_header }}</head><body class="page-width-{{ settings.page_width }} card-hover-effect-{{ settings.card_hover_effect }}">{% render 'skip-to-content-link', href: '#MainContent', text: 'accessibility.skip_to_text' %}<div class="page-wrapper"><div id="header-group">{% sections 'header-group' %}</div><main id="MainContent" class="hv-main content-for-layout" role="main" data-template="{{ template }}">{{ content_for_layout }}</main><div class="hv-footer-wrapper" data-hv-footer-group>{% sections 'footer-group' %}</div></div>{% render 'cart-drawer', render_wrapper: true %}{% render 'theme-drawer' %}{% render 'search-modal' %}{% if settings.quick_add or settings.mobile_quick_add %}{% render 'quick-add-modal' %}{% endif %}</body></html>