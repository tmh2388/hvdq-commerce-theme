<section id="hvdq-demo-products" class="hvdq-demo-products" {{ section.shopify_attributes }}>
  <div class="hvdq-demo-products__header">
    <div>
      {% if section.settings.eyebrow != blank %}
        <p class="hvdq-demo-products__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="hvdq-demo-products__heading">{{ section.settings.heading | escape }}</h2>
      {% endif %}
    </div>
    {% if section.settings.note != blank %}
      <p class="hvdq-demo-products__note">{{ section.settings.note | escape }}</p>
    {% endif %}
  </div>

  <div class="hvdq-demo-products__grid">
    {% for block in section.blocks %}
      <article class="hvdq-demo-product" {{ block.shopify_attributes }}>
        <div class="hvdq-demo-product__visual hvdq-demo-product__visual--{{ block.settings.visual }}">
          <span class="hvdq-demo-product__badge">{{ block.settings.badge | escape }}</span>
          {% case block.settings.visual %}
            {% when 'watch-blue' %}
              <svg viewBox="0 0 600 760" role="img" aria-label="Đồng hồ pháp lam xanh lam minh họa">
                <defs>
                  <radialGradient id="blueDial-{{ block.id }}" cx="38%" cy="32%" r="70%">
                    <stop offset="0" stop-color="#5eb6c2"/>
                    <stop offset=".42" stop-color="#145b68"/>
                    <stop offset="1" stop-color="#071c25"/>
                  </radialGradient>
                  <linearGradient id="blueMetal-{{ block.id }}" x1="0" x2="1">
                    <stop stop-color="#eee7d8"/>
                    <stop offset=".45" stop-color="#8d8578"/>
                    <stop offset=".7" stop-color="#fbf7ee"/>
                    <stop offset="1" stop-color="#777064"/>
                  </linearGradient>
                </defs>
                <rect width="600" height="760" fill="#d8d1c4"/>
                <path d="M235 0h130l32 208H203zM203 552h194l-32 208H235z" fill="#362a22"/>
                <path d="M240 0h120l20 190H220zM220 570h160l-20 190H240z" fill="#5b4434"/>
                <circle cx="300" cy="380" r="205" fill="url(#blueMetal-{{ block.id }})"/>
                <circle cx="300" cy="380" r="178" fill="#091820"/>
                <circle cx="300" cy="380" r="163" fill="url(#blueDial-{{ block.id }})"/>
                <g fill="none" stroke="#d0a952" stroke-width="5" opacity=".9">
                  <path d="M190 327c55-72 137-77 220-12-65 9-103 52-112 132-35-61-72-101-108-120z"/>
                  <path d="M206 443c55-47 115-43 183 11M225 271c55 17 103 17 150-2"/>
                </g>
                <g stroke="#f5e9c7" stroke-width="5" stroke-linecap="round">
                  <path d="M300 230v18M300 512v18M150 380h18M432 380h18"/>
                  <path d="M300 380l-75-48M300 380l67-91" stroke-width="7"/>
                </g>
                <circle cx="300" cy="380" r="11" fill="#d7b15a"/>
                <rect x="503" y="355" width="25" height="50" rx="6" fill="#8d8578"/>
              </svg>
            {% when 'watch-red' %}
              <svg viewBox="0 0 600 760" role="img" aria-label="Đồng hồ pháp lam đỏ son minh họa">
                <defs>
                  <radialGradient id="redDial-{{ block.id }}" cx="42%" cy="36%" r="72%">
                    <stop offset="0" stop-color="#da745f"/>
                    <stop offset=".45" stop-color="#8d231e"/>
                    <stop offset="1" stop-color="#310b0c"/>
                  </radialGradient>
                </defs>
                <rect width="600" height="760" fill="#c8b8a0"/>
                <path d="M232 0h136l29 205H203zM203 555h194l-29 205H232z" fill="#201716"/>
                <circle cx="300" cy="380" r="207" fill="#c8a75d"/>
                <circle cx="300" cy="380" r="184" fill="#29201b"/>
                <circle cx="300" cy="380" r="166" fill="url(#redDial-{{ block.id }})"/>
                <g fill="none" stroke="#e9be64" stroke-width="5">
                  <path d="M183 388c67-95 154-114 241-55-84 12-137 73-154 182-9-63-38-105-87-127z"/>
                  <path d="M194 303c79 22 148 15 207-23M204 466c66-39 130-32 192 19"/>
                </g>
                <g fill="#f5e7c5">
                  <circle cx="300" cy="229" r="5"/><circle cx="300" cy="531" r="5"/>
                  <circle cx="149" cy="380" r="5"/><circle cx="451" cy="380" r="5"/>
                </g>
                <path d="M300 380l-90-25M300 380l42-105" stroke="#f8efdb" stroke-width="7" stroke-linecap="round"/>
                <circle cx="300" cy="380" r="11" fill="#e9be64"/>
              </svg>
            {% when 'tie-clip' %}
              <svg viewBox="0 0 600 760" role="img" aria-label="Kẹp cà vạt pháp lam minh họa">
                <defs>
                  <linearGradient id="jade-{{ block.id }}" x1="0" y1="0" x2="1" y2="1">
                    <stop stop-color="#9bbfae"/><stop offset=".48" stop-color="#2e6a5c"/><stop offset="1" stop-color="#102e2b"/>
                  </linearGradient>
                </defs>
                <rect width="600" height="760" fill="#d9d2c5"/>
                <g transform="rotate(-18 300 380)">
                  <rect x="72" y="315" width="456" height="130" rx="28" fill="#9b8251"/>
                  <rect x="89" y="332" width="422" height="96" rx="18" fill="url(#jade-{{ block.id }})"/>
                  <g fill="none" stroke="#d5b264" stroke-width="5">
                    <path d="M103 388c70-79 137-76 201 9s131 88 200 7"/>
                    <path d="M111 360c68 70 129 76 184 17s122-66 202-11"/>
                    <circle cx="300" cy="380" r="34"/>
                  </g>
                  <circle cx="300" cy="380" r="13" fill="#d5b264"/>
                </g>
                <ellipse cx="300" cy="575" rx="205" ry="32" fill="#6b5a47" opacity=".15"/>
              </svg>
            {% else %}
              <svg viewBox="0 0 600 760" role="img" aria-label="Khuy măng sét pháp lam minh họa">
                <defs>
                  <radialGradient id="night-{{ block.id }}" cx="35%" cy="30%" r="75%">
                    <stop stop-color="#5d7895"/><stop offset=".5" stop-color="#1a314b"/><stop offset="1" stop-color="#08111f"/>
                  </radialGradient>
                </defs>
                <rect width="600" height="760" fill="#cfc7ba"/>
                <g transform="translate(135 205) rotate(-12 160 160)">
                  <rect x="35" y="35" width="250" height="250" rx="42" fill="#a58b55"/>
                  <rect x="54" y="54" width="212" height="212" rx="32" fill="url(#night-{{ block.id }})"/>
                  <path d="M76 195c68-107 130-118 184-34-76 5-125 39-147 101" fill="none" stroke="#d8b764" stroke-width="6"/>
                  <circle cx="112" cy="115" r="16" fill="#d8b764"/>
                </g>
                <g transform="translate(305 382) rotate(14 105 105)">
                  <rect x="10" y="10" width="190" height="190" rx="35" fill="#a58b55"/>
                  <rect x="27" y="27" width="156" height="156" rx="25" fill="url(#night-{{ block.id }})"/>
                  <path d="M45 125c52-78 99-85 138-23-54 4-93 27-112 71" fill="none" stroke="#d8b764" stroke-width="5"/>
                </g>
                <ellipse cx="300" cy="650" rx="205" ry="35" fill="#6b5a47" opacity=".14"/>
              </svg>
          {% endcase %}
        </div>
        <div class="hvdq-demo-product__content">
          <p class="hvdq-demo-product__meta">{{ block.settings.meta | escape }}</p>
          <h3 class="hvdq-demo-product__title">{{ block.settings.title | escape }}</h3>
          <p class="hvdq-demo-product__description">{{ block.settings.description | escape }}</p>
          <div class="hvdq-demo-product__footer">
            <span class="hvdq-demo-product__price">{{ block.settings.price | escape }}</span>
            <span class="hvdq-demo-product__action">Xem chi tiết <span aria-hidden="true">→</span></span>
          </div>
        </div>
      </article>
    {% endfor %}
  </div>
</section>

{% stylesheet %}
  .hvdq-demo-products {
    padding: clamp(3.5rem, 7vw, 7rem) clamp(1.25rem, 5vw, 5rem);
    background: #f3f0e9;
    color: #191816;
  }

  .hvdq-demo-products__header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 2rem;
  }

  .hvdq-demo-products__eyebrow,
  .hvdq-demo-product__meta {
    margin: 0 0 0.55rem;
    color: #8c713d;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .hvdq-demo-products__heading {
    max-width: 18ch;
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: clamp(2rem, 4vw, 4rem);
    font-weight: 500;
    line-height: 1.05;
  }

  .hvdq-demo-products__note {
    max-width: 32rem;
    margin: 0;
    color: #6a665f;
    font-size: 0.82rem;
    line-height: 1.5;
    text-align: right;
  }

  .hvdq-demo-products__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    background: #bdb6aa;
    border: 1px solid #bdb6aa;
  }

  .hvdq-demo-product {
    min-width: 0;
    background: #f8f6f1;
  }

  .hvdq-demo-product__visual {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    background: #d8d1c4;
  }

  .hvdq-demo-product__visual svg {
    width: 100%;
    height: 100%;
    transition: transform 600ms cubic-bezier(.2,.8,.2,1);
  }

  .hvdq-demo-product:hover .hvdq-demo-product__visual svg {
    transform: scale(1.025);
  }

  .hvdq-demo-product__badge {
    position: absolute;
    z-index: 1;
    top: 1rem;
    left: 1rem;
    padding: 0.38rem 0.6rem;
    background: rgb(20 20 18 / 82%);
    color: #fff;
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .hvdq-demo-product__content {
    padding: 1.25rem;
  }

  .hvdq-demo-product__title {
    margin: 0 0 0.6rem;
    font-family: var(--font-heading--family);
    font-size: 1.3rem;
    font-weight: 500;
  }

  .hvdq-demo-product__description {
    min-height: 4.5em;
    margin: 0;
    color: #68645d;
    font-size: 0.82rem;
    line-height: 1.5;
  }

  .hvdq-demo-product__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid #ded8cd;
  }

  .hvdq-demo-product__price {
    font-weight: 600;
  }

  .hvdq-demo-product__action {
    color: #8c713d;
    font-size: 0.75rem;
  }

  @media screen and (max-width: 990px) {
    .hvdq-demo-products__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 600px) {
    .hvdq-demo-products__header {
      display: block;
    }

    .hvdq-demo-products__note {
      margin-top: 1rem;
      text-align: left;
    }

    .hvdq-demo-products__grid {
      grid-template-columns: 1fr;
    }

    .hvdq-demo-product__description {
      min-height: 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "HVDQ Demo Products",
  "tag": "section",
  "class": "hvdq-section",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Nhãn phụ / Eyebrow" },
    { "type": "text", "id": "heading", "label": "Tiêu đề / Heading" },
    { "type": "textarea", "id": "note", "label": "Ghi chú demo / Demo note" }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Sản phẩm demo",
      "settings": [
        { "type": "text", "id": "badge", "label": "Nhãn / Badge" },
        { "type": "text", "id": "meta", "label": "Phân loại / Meta" },
        { "type": "text", "id": "title", "label": "Tên / Title" },
        { "type": "textarea", "id": "description", "label": "Mô tả / Description" },
        { "type": "text", "id": "price", "label": "Giá / Price" },
        {
          "type": "select",
          "id": "visual",
          "label": "Minh họa / Visual",
          "options": [
            { "value": "watch-blue", "label": "Đồng hồ xanh" },
            { "value": "watch-red", "label": "Đồng hồ đỏ" },
            { "value": "tie-clip", "label": "Kẹp cà vạt" },
            { "value": "cufflinks", "label": "Khuy măng sét" }
          ],
          "default": "watch-blue"
        }
      ]
    }
  ],
  "presets": [{ "name": "HVDQ Demo Products" }]
}
{% endschema %}
