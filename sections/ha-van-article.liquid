<article class="hv-article-page"><div class="hv-article-page__meta">{{ article.published_at | date: '%d.%m.%Y' }} · {{ article.author }}</div><h1>{{ article.title }}</h1>{% if article.image != blank %}<div class="hv-article-page__image">{{ article.image | image_url: width: 1800 | image_tag: widths: '720,1100,1500,1800', loading: 'eager', alt: article.title }}</div>{% endif %}<div class="hv-article-page__content rte">{{ article.content }}</div></article>{% schema %}{"name":"HA VAN — Article","settings":[],"presets":[{"name":"HA VAN — Article"}]}{% endschema %}