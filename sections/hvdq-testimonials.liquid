{% liquid
  assign valid_blocks = section.blocks | where: 'type', 'testimonial'
%}

{% capture testimonials_markup %}
  {% for block in valid_blocks %}
    {% if block.settings.quote != blank %}
      {% liquid
        assign has_image = false
        if block.settings.image != blank
          assign has_image = true
        endif
        assign testimonial_alt = block.settings.image_alt
        if testimonial_alt == blank and has_image
          assign testimonial_alt = block.settings.customer_name
        endif
      %}
      <li class="hvdq-testimonial" {{ block.shopify_attributes }}>
        <blockquote class="hvdq-testimonial__quote">
          <p>{{ block.settings.quote | escape }}</p>
        </blockquote>
        {% if block.settings.customer_name != blank or has_image %}
          <figcaption class="hvdq-testimonial__attribution">
            {% if has_image %}
              <img
                srcset="
                  {{ block.settings.image | image_url: width: 80 }} 80w,
                  {{ block.settings.image | image_url: width: 160 }} 160w
                "
                sizes="48px"
                src="{{ block.settings.image | image_url: width: 80 }}"
                alt="{{ testimonial_alt | escape }}"
                width="{{ block.settings.image.width }}"
                height="{{ block.settings.image.height }}"
                loading="lazy"
                class="hvdq-testimonial__image"
              >
            {% endif %}
            {% if block.settings.customer_name != blank %}
              <span class="hvdq-testimonial__name">{{ block.settings.customer_name | escape }}</span>
            {% endif %}
            {% if block.settings.customer_role != blank %}
              <span class="hvdq-testimonial__role">{{ block.settings.customer_role | escape }}</span>
            {% endif %}
          </figcaption>
        {% endif %}
      </li>
    {% endif %}
  {% endfor %}
{% endcapture %}

{% assign trimmed_testimonials = testimonials_markup | strip %}

{% if trimmed_testimonials != blank %}
  <section class="hvdq-testimonials" {{ section.shopify_attributes }}>
    {% if section.settings.heading != blank %}
      <h2 class="hvdq-testimonials__heading">{{ section.settings.heading | escape }}</h2>
    {% endif %}
    <ul class="hvdq-testimonials__grid" role="list">
      {{ testimonials_markup }}
    </ul>
  </section>
{% endif %}

{% schema %}
{
  "name": "HVDQ Testimonials",
  "tag": "section",
  "class": "hvdq-section",
  "max_blocks": 9,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Tiêu đề / Heading"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Đánh giá / Testimonial",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Trích dẫn / Quote"
        },
        {
          "type": "text",
          "id": "customer_name",
          "label": "Tên khách hàng / Customer name"
        },
        {
          "type": "text",
          "id": "customer_role",
          "label": "Vai trò khách hàng / Customer role"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Ảnh / Image"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Văn bản thay thế cho ảnh / Image alt text",
          "info": "Dùng tên khách hàng nếu để trống. / Falls back to the customer name."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HVDQ Testimonials"
    }
  ]
}
{% endschema %}
