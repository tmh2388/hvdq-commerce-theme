{% liquid
  assign visible_blocks = section.blocks | where: 'type', 'category'
%}

{% if visible_blocks.size > 0 %}
  <section class="hvdq-categories" {{ section.shopify_attributes }}>
    {% if section.settings.heading != blank %}
      <h2 class="hvdq-categories__heading">{{ section.settings.heading | escape }}</h2>
    {% endif %}

    <ul class="hvdq-categories__grid" role="list">
      {% for block in visible_blocks %}
        {% liquid
          assign collection = block.settings.collection

          assign category_title = block.settings.custom_title
          if category_title == blank and collection != blank
            assign category_title = collection.title
          endif

          assign category_url = block.settings.custom_url
          if category_url == blank and collection != blank
            assign category_url = collection.url
          endif

          assign category_image = block.settings.custom_image
          if category_image == blank and collection != blank
            assign category_image = collection.featured_image
          endif

          assign category_alt = block.settings.image_alt
          if category_alt == blank
            assign category_alt = category_title
          endif
        %}
        {% if category_title != blank or category_image != blank %}
          <li class="hvdq-category" {{ block.shopify_attributes }}>
            {% if category_url != blank %}
              <a href="{{ category_url }}" class="hvdq-category__link">
            {% endif %}
              <span class="hvdq-category__media">
                {% if category_image != blank %}
                  <img
                    srcset="
                      {{ category_image | image_url: width: 400 }} 400w,
                      {{ category_image | image_url: width: 700 }} 700w,
                      {{ category_image | image_url: width: 1000 }} 1000w
                    "
                    sizes="(min-width: 750px) 25vw, 45vw"
                    src="{{ category_image | image_url: width: 700 }}"
                    alt="{{ category_alt | escape }}"
                    width="{{ category_image.width }}"
                    height="{{ category_image.height }}"
                    loading="lazy"
                    class="hvdq-category__image"
                  >
                {% else %}
                  <span class="hvdq-category__placeholder" aria-hidden="true">
                    {{ 'collection' | placeholder_svg_tag: 'hvdq-category__placeholder-svg' }}
                  </span>
                {% endif %}
              </span>
              {% if category_title != blank %}
                <span class="hvdq-category__title">{{ category_title | escape }}</span>
              {% endif %}
            {% if category_url != blank %}
              </a>
            {% endif %}
          </li>
        {% endif %}
      {% endfor %}
    </ul>
  </section>
{% endif %}

{% schema %}
{
  "name": "HVDQ Featured Categories",
  "tag": "section",
  "class": "hvdq-section",
  "max_blocks": 10,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Tiêu đề / Heading"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Danh mục / Category",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "t:settings.collection"
        },
        {
          "type": "text",
          "id": "custom_title",
          "label": "Tiêu đề tùy chỉnh / Custom title",
          "info": "Dùng tên bộ sưu tập nếu để trống. / Falls back to the collection's title."
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Ảnh tùy chỉnh / Custom image",
          "info": "Dùng ảnh bộ sưu tập nếu để trống. / Falls back to the collection's image."
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Văn bản thay thế cho ảnh / Image alt text",
          "info": "Dùng văn bản thay thế của ảnh nếu để trống. / Falls back to the image's own alt text."
        },
        {
          "type": "url",
          "id": "custom_url",
          "label": "Liên kết tùy chỉnh / Custom link",
          "info": "Dùng liên kết bộ sưu tập nếu để trống. / Falls back to the collection's link."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HVDQ Featured Categories",
      "blocks": [
        { "type": "category" },
        { "type": "category" },
        { "type": "category" }
      ]
    }
  ]
}
{% endschema %}
