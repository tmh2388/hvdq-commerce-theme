<section class="hv-page-head"><div class="hv-shell"><div class="hv-kicker">THE HOUSE OF EXCEPTIONAL CRAFT</div><h1>{{ blog.title }}</h1><p>{{ section.settings.intro }}</p></div></section><section class="hv-section" style="padding-top:10px"><div class="hv-shell"><div class="hv-blog-grid">{% paginate blog.articles by section.settings.posts_per_page %}{% for article in blog.articles %}<a class="hv-article-card" href="{{ article.url }}"><div class="hv-article-card__media">{% if article.image != blank %}{{ article.image | image_url: width: 900 | image_tag: widths: '360,540,720,900', loading: 'lazy', alt: article.title }}{% endif %}</div><div class="hv-article-card__body"><div class="hv-kicker">{{ article.tags.first | default: 'Journal' }}</div><h2>{{ article.title }}</h2><p>{{ article.excerpt_or_content | strip_html | truncate: 150 }}</p><small>{{ article.published_at | date: '%d.%m.%Y' }}</small></div></a>{% endfor %}{% if paginate.pages > 1 %}<div style="grid-column:1/-1">{{ paginate | default_pagination }}</div>{% endif %}{% endpaginate %}</div></div></section>{% schema %}{"name":"HA VAN — Journal","settings":[{"type":"textarea","id":"intro","label":"Giới thiệu","default":"Câu chuyện về thủ nghệ, văn hóa và cảm hứng."},{"type":"range","id":"posts_per_page","label":"Số bài mỗi trang","min":3,"max":24,"step":3,"default":9}],"presets":[{"name":"HA VAN — Journal"}]}{% endschema %}