{% liquid
  assign has_desktop_image = false
  if section.settings.desktop_image != blank
    assign has_desktop_image = true
  endif

  assign has_mobile_image = false
  if section.settings.mobile_image != blank
    assign has_mobile_image = true
  endif

  assign image_alt = section.settings.image_alt
  if image_alt == blank and has_desktop_image
    assign image_alt = section.settings.desktop_image.alt
  endif
%}

{{ 'hvdq-homepage.css' | asset_url | stylesheet_tag }}

<section
  class="hvdq-hero hvdq-hero--content-{{ section.settings.content_alignment }} hvdq-hero--image-{{ section.settings.image_position }}"
  {{ section.shopify_attributes }}
>
  <div class="hvdq-hero__media">
    {% if has_desktop_image %}
      <img
        srcset="
          {{ section.settings.desktop_image | image_url: width: 750 }} 750w,
          {{ section.settings.desktop_image | image_url: width: 1100 }} 1100w,
          {{ section.settings.desktop_image | image_url: width: 1500 }} 1500w,
          {{ section.settings.desktop_image | image_url: width: 2200 }} 2200w
        "
        sizes="(min-width: 750px) 50vw, 100vw"
        src="{{ section.settings.desktop_image | image_url: width: 1500 }}"
        alt="{{ image_alt | escape }}"
        width="{{ section.settings.desktop_image.width }}"
        height="{{ section.settings.desktop_image.height }}"
        loading="eager"
        fetchpriority="high"
        class="hvdq-hero__image hvdq-hero__image--desktop{% if has_mobile_image %} hvdq-hero__image--desktop-only{% endif %}"
      >
      {% if has_mobile_image %}
        <img
          srcset="
            {{ section.settings.mobile_image | image_url: width: 480 }} 480w,
            {{ section.settings.mobile_image | image_url: width: 750 }} 750w,
            {{ section.settings.mobile_image | image_url: width: 1100 }} 1100w
          "
          sizes="100vw"
          src="{{ section.settings.mobile_image | image_url: width: 750 }}"
          alt="{{ image_alt | escape }}"
          width="{{ section.settings.mobile_image.width }}"
          height="{{ section.settings.mobile_image.height }}"
          loading="eager"
          fetchpriority="high"
          class="hvdq-hero__image hvdq-hero__image--mobile-only"
        >
      {% endif %}
      {% if section.settings.overlay_strength > 0 %}
        <span
          class="hvdq-hero__overlay"
          style="--hvdq-hero-overlay-opacity: {{ section.settings.overlay_strength | times: 0.01 }};"
          aria-hidden="true"
        ></span>
      {% endif %}
    {% else %}
      <div
        class="hvdq-hero__placeholder hvdq-hero__placeholder--photo"
        style="background-image: url('{{ 'hvdq-demo-products.png' | asset_url }}');"
        aria-hidden="true"
      >
        <svg class="hvdq-hero__demo-art" viewBox="0 0 900 1125" role="presentation">
          <defs>
            <radialGradient id="hvdqHeroDial" cx="38%" cy="30%" r="72%">
              <stop offset="0" stop-color="#68c0c8"/>
              <stop offset=".4" stop-color="#175f6d"/>
              <stop offset="1" stop-color="#071820"/>
            </radialGradient>
            <linearGradient id="hvdqHeroMetal" x1="0" x2="1">
              <stop stop-color="#f1eadc"/>
              <stop offset=".35" stop-color="#877d6c"/>
              <stop offset=".63" stop-color="#fffaf0"/>
              <stop offset="1" stop-color="#726858"/>
            </linearGradient>
            <linearGradient id="hvdqHeroBackdrop" x1="0" y1="0" x2="1" y2="1">
              <stop stop-color="#dad3c6"/>
              <stop offset=".58" stop-color="#b8aa96"/>
              <stop offset="1" stop-color="#83715d"/>
            </linearGradient>
          </defs>
          <rect width="900" height="1125" fill="url(#hvdqHeroBackdrop)"/>
          <circle cx="745" cy="155" r="245" fill="none" stroke="#d8b665" stroke-width="2" opacity=".55"/>
          <circle cx="745" cy="155" r="190" fill="none" stroke="#d8b665" stroke-width="1" opacity=".35"/>
          <path d="M0 920c225-115 460-107 900 35v170H0z" fill="#171916" opacity=".92"/>
          <g transform="translate(112 70) rotate(-9 340 500)">
            <path d="M277 0h196l45 305H232zM232 765h286l-45 360H277z" fill="#35271f"/>
            <path d="M291 0h168l28 281H263zM263 789h224l-28 336H291z" fill="#5c4231"/>
            <circle cx="375" cy="535" r="296" fill="url(#hvdqHeroMetal)"/>
            <circle cx="375" cy="535" r="263" fill="#08151c"/>
            <circle cx="375" cy="535" r="240" fill="url(#hvdqHeroDial)"/>
            <g fill="none" stroke="#d9b35b" stroke-width="8" opacity=".95">
              <path d="M210 458c82-107 203-114 327-18-97 13-155 77-168 195-52-90-105-149-159-177z"/>
              <path d="M231 628c82-70 171-64 272 17M262 376c81 25 154 24 223-3"/>
              <path d="M244 493c52 28 96 74 132 139M348 395c-23 91-13 168 32 231"/>
            </g>
            <g stroke="#f7ecd1" stroke-width="8" stroke-linecap="round">
              <path d="M375 319v27M375 724v27M159 535h27M564 535h27"/>
              <path d="M375 535l-112-71M375 535l100-134" stroke-width="11"/>
            </g>
            <circle cx="375" cy="535" r="16" fill="#d8b15a"/>
            <rect x="669" y="498" width="38" height="74" rx="9" fill="#8d826f"/>
          </g>
          <text x="58" y="1050" fill="#e7d6aa" font-size="20" letter-spacing="6">HVDQ · DEMO VISUAL</text>
        </svg>
      </div>
    {% endif %}
    {% if section.settings.show_decorative_mark %}
      <span class="hvdq-hero__decorative-mark" aria-hidden="true"></span>
    {% endif %}
  </div>

  <div class="hvdq-hero__content">
    {% if section.settings.eyebrow != blank %}
      <p class="hvdq-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {% endif %}

    {% if section.settings.heading != blank %}
      <h1 class="hvdq-hero__heading">{{ section.settings.heading | escape }}</h1>
    {% endif %}

    {% if section.settings.body != blank %}
      <div class="hvdq-hero__body">{{ section.settings.body }}</div>
    {% endif %}

    {% if section.settings.primary_button_label != blank or section.settings.secondary_button_label != blank %}
      <div class="hvdq-hero__actions">
        {% if section.settings.primary_button_label != blank and section.settings.primary_button_url != blank %}
          <a href="{{ section.settings.primary_button_url }}" class="button">
            {{- section.settings.primary_button_label | escape -}}
          </a>
        {% endif %}
        {% if section.settings.secondary_button_label != blank and section.settings.secondary_button_url != blank %}
          <a href="{{ section.settings.secondary_button_url }}" class="button-secondary">
            {{- section.settings.secondary_button_label | escape -}}
          </a>
        {% endif %}
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "HVDQ Hero",
  "tag": "section",
  "class": "hvdq-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Nhãn phụ / Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Tiêu đề / Heading"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Nội dung / Body"
    },
    {
      "type": "header",
      "content": "Hình ảnh / Media"
    },
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Ảnh máy tính / Desktop image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Ảnh điện thoại / Mobile image",
      "info": "Chỉ hiển thị dưới 750px. Dùng ảnh máy tính nếu để trống. / Shown only below 750px. Falls back to the desktop image."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Văn bản thay thế cho ảnh / Image alt text",
      "info": "Dùng văn bản thay thế của ảnh nếu để trống. / Falls back to the image's own alt text."
    },
    {
      "type": "range",
      "id": "overlay_strength",
      "label": "Độ đậm lớp phủ / Overlay strength",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "%",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "show_decorative_mark",
      "label": "Hiển thị chi tiết trang trí / Show decorative mark",
      "default": true
    },
    {
      "type": "header",
      "content": "Hành động / Actions"
    },
    {
      "type": "text",
      "id": "primary_button_label",
      "label": "Nhãn nút chính / Primary button label"
    },
    {
      "type": "url",
      "id": "primary_button_url",
      "label": "Liên kết nút chính / Primary button link"
    },
    {
      "type": "text",
      "id": "secondary_button_label",
      "label": "Nhãn nút phụ / Secondary button label"
    },
    {
      "type": "url",
      "id": "secondary_button_url",
      "label": "Liên kết nút phụ / Secondary button link"
    },
    {
      "type": "header",
      "content": "Bố cục / Layout"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Căn chỉnh nội dung / Content alignment",
      "options": [
        { "value": "start", "label": "t:options.left" },
        { "value": "center", "label": "t:options.center" }
      ],
      "default": "start"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Vị trí ảnh / Image position",
      "options": [
        { "value": "start", "label": "t:options.left" },
        { "value": "end", "label": "t:options.right" }
      ],
      "default": "end"
    }
  ],
  "presets": [
    {
      "name": "HVDQ Hero",
      "settings": {
        "eyebrow": "HVDQ",
        "heading": "Thủ Nghệ Bách Phẩm Đường",
        "content_alignment": "start",
        "image_position": "end",
        "show_decorative_mark": true
      }
    }
  ]
}
{% endschema %}
