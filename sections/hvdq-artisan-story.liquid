{% liquid
  assign has_portrait = false
  if section.settings.portrait != blank
    assign has_portrait = true
  endif

  assign portrait_alt = section.settings.portrait_alt
  if portrait_alt == blank and has_portrait
    assign portrait_alt = section.settings.portrait.alt
  endif
  if portrait_alt == blank
    assign portrait_alt = section.settings.artisan_name
  endif
%}

<section
  class="hvdq-artisan hvdq-artisan--{{ section.settings.layout_direction }}"
  {{ section.shopify_attributes }}
>
  <div class="hvdq-artisan__media">
    {% if has_portrait %}
      <img
        srcset="
          {{ section.settings.portrait | image_url: width: 500 }} 500w,
          {{ section.settings.portrait | image_url: width: 800 }} 800w,
          {{ section.settings.portrait | image_url: width: 1200 }} 1200w
        "
        sizes="(min-width: 750px) 40vw, 90vw"
        src="{{ section.settings.portrait | image_url: width: 800 }}"
        alt="{{ portrait_alt | escape }}"
        width="{{ section.settings.portrait.width }}"
        height="{{ section.settings.portrait.height }}"
        loading="lazy"
        class="hvdq-artisan__image"
      >
    {% else %}
      <div class="hvdq-artisan__placeholder" aria-hidden="true">
        {{ 'lifestyle' | placeholder_svg_tag: 'hvdq-artisan__placeholder-svg' }}
      </div>
    {% endif %}
  </div>

  <div class="hvdq-artisan__content">
    {% if section.settings.eyebrow != blank %}
      <p class="hvdq-artisan__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {% endif %}

    {% if section.settings.heading != blank %}
      <h2 class="hvdq-artisan__heading">{{ section.settings.heading | escape }}</h2>
    {% endif %}

    {% if section.settings.richtext_body != blank %}
      <div class="hvdq-artisan__body">{{ section.settings.richtext_body }}</div>
    {% endif %}

    {% if section.settings.artisan_name != blank %}
      <p class="hvdq-artisan__attribution">
        <span class="hvdq-artisan__name">{{ section.settings.artisan_name | escape }}</span>
        {% if section.settings.artisan_role != blank %}
          <span class="hvdq-artisan__role">{{ section.settings.artisan_role | escape }}</span>
        {% endif %}
      </p>
    {% endif %}

    {% if section.settings.link_label != blank and section.settings.link_url != blank %}
      <a href="{{ section.settings.link_url }}" class="hvdq-artisan__link">
        {{- section.settings.link_label | escape -}}
      </a>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "HVDQ Artisan Story",
  "tag": "section",
  "class": "hvdq-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Nhãn phụ / Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Tiêu đề / Heading"
    },
    {
      "type": "richtext",
      "id": "richtext_body",
      "label": "Nội dung / Body"
    },
    {
      "type": "header",
      "content": "Hình ảnh / Media"
    },
    {
      "type": "image_picker",
      "id": "portrait",
      "label": "Ảnh chân dung / Portrait"
    },
    {
      "type": "text",
      "id": "portrait_alt",
      "label": "Văn bản thay thế cho ảnh / Image alt text",
      "info": "Dùng văn bản thay thế của ảnh nếu để trống. / Falls back to the image's own alt text."
    },
    {
      "type": "header",
      "content": "Thông tin tác giả / Attribution"
    },
    {
      "type": "text",
      "id": "artisan_name",
      "label": "Tên nghệ nhân / Artisan name",
      "default": "Đặng Hương Quỳnh"
    },
    {
      "type": "text",
      "id": "artisan_role",
      "label": "Vai trò nghệ nhân / Artisan role",
      "default": "Nghệ nhân Pháp Lam"
    },
    {
      "type": "header",
      "content": "Hành động / Actions"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Nhãn liên kết / Link label"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Liên kết / Link"
    },
    {
      "type": "header",
      "content": "Bố cục / Layout"
    },
    {
      "type": "select",
      "id": "layout_direction",
      "label": "Vị trí ảnh / Image position",
      "options": [
        { "value": "image-start", "label": "t:options.left" },
        { "value": "image-end", "label": "t:options.right" }
      ],
      "default": "image-start"
    }
  ],
  "presets": [
    {
      "name": "HVDQ Artisan Story",
      "settings": {
        "eyebrow": "HVDQ",
        "artisan_name": "Đặng Hương Quỳnh",
        "artisan_role": "Nghệ nhân Pháp Lam",
        "layout_direction": "image-start"
      }
    }
  ]
}
{% endschema %}
