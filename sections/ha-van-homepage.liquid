{% liquid
  assign hero_image = section.settings.hero_image
%}
<div class="hv-home-sequence">
<section class="hv-hero"><div class="hv-hero__media">{% if hero_image != blank %}{{ hero_image | image_url: width: 2400 | image_tag: widths: '750,1100,1600,2000,2400', sizes: '100vw', loading: 'eager', fetchpriority: 'high', alt: section.settings.heading }}{% endif %}</div><div class="hv-shell hv-hero__content"><div class="hv-hero__copy"><div class="hv-kicker">{{ section.settings.kicker }}</div><h1 class="hv-title">{{ section.settings.heading }}</h1><div class="hv-lead">{{ section.settings.intro }}</div><div class="hv-actions"><a class="hv-button hv-button--primary" href="{{ section.settings.primary_link | default: routes.all_products_collection_url }}">{{ section.settings.primary_label }}</a><a class="hv-button hv-button--secondary" href="{{ section.settings.secondary_link | default: '/pages/private-commission' }}">{{ section.settings.secondary_label }}</a></div></div></div></section>
<div class="hv-trust" aria-label="Cam kết thương hiệu">{% for block in section.blocks %}{% if block.type == 'trust' %}<div class="hv-trust__item" {{ block.shopify_attributes }}><strong>{{ block.settings.title }}</strong><span>{{ block.settings.copy }}</span></div>{% endif %}{% endfor %}</div>
<section class="hv-section"><div class="hv-shell"><h2 class="hv-section-title">{{ section.settings.collections_heading }}</h2><div class="hv-card-grid">{% assign collection_blocks = section.blocks | where: 'type', 'collection' %}{% for block in collection_blocks %}{% assign selected_collection = block.settings.collection %}{% if selected_collection != blank %}<a class="hv-card" href="{{ selected_collection.url }}" {{ block.shopify_attributes }}><div class="hv-card__media">{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 900 | image_tag: widths: '360,540,720,900', loading: 'lazy', alt: block.settings.title }}{% elsif selected_collection.featured_image != blank %}{{ selected_collection.featured_image | image_url: width: 900 | image_tag: widths: '360,540,720,900', loading: 'lazy', alt: block.settings.title }}{% elsif selected_collection.products.first.featured_image != blank %}{{ selected_collection.products.first.featured_image | image_url: width: 900 | image_tag: widths: '360,540,720,900', loading: 'lazy', alt: block.settings.title }}{% endif %}</div><div class="hv-card__body"><div class="hv-card__eyebrow">{{ block.settings.eyebrow }}</div><div class="hv-card__title">{{ block.settings.title }}</div><div class="hv-card__copy">{{ block.settings.copy }}</div></div></a>{% endif %}{% endfor %}</div></div></section>
<section class="hv-shell hv-dark-feature"><div class="hv-dark-feature__copy"><div class="hv-kicker">{{ section.settings.bespoke_kicker }}</div><h2>{{ section.settings.bespoke_heading }}</h2><p>{{ section.settings.bespoke_copy }}</p><div class="hv-actions"><a class="hv-button hv-button--secondary" style="color:#fff;border-color:#fff" href="{{ section.settings.bespoke_link }}">{{ section.settings.bespoke_label }}</a></div></div><div class="hv-dark-feature__media">{% if section.settings.bespoke_image != blank %}{{ section.settings.bespoke_image | image_url: width: 1600 | image_tag: widths: '640,960,1280,1600', loading: 'lazy', alt: section.settings.bespoke_heading }}{% elsif hero_image != blank %}{{ hero_image | image_url: width: 1600 | image_tag: widths: '640,960,1280,1600', loading: 'lazy', alt: section.settings.bespoke_heading }}{% endif %}</div></section>
<section class="hv-section"><div class="hv-shell hv-split"><div class="hv-split__item"><div class="hv-kicker">Nghệ nhân</div><h3>{{ section.settings.artisan_heading }}</h3><p>{{ section.settings.artisan_copy }}</p><a href="{{ section.settings.artisan_link }}">Khám phá câu chuyện →</a></div><div class="hv-split__item"><div class="hv-kicker">Journal</div><h3>{{ section.settings.journal_heading }}</h3><p>{{ section.settings.journal_copy }}</p><a href="{{ section.settings.journal_link }}">Xem Journal →</a></div></div></section>
<section class="hv-section" style="padding-top:0"><div class="hv-shell hv-newsletter"><div><div class="hv-kicker">Nhận cảm hứng</div><h3>{{ section.settings.newsletter_heading }}</h3><p>{{ section.settings.newsletter_copy }}</p></div>{% form 'customer' %}<input type="hidden" name="contact[tags]" value="newsletter"><input type="email" name="contact[email]" placeholder="Email của bạn" required><button class="hv-button hv-button--primary" type="submit">Đăng ký</button>{% endform %}</div></section>
</div>
{% schema %}{"name":"HA VAN — Homepage","tag":"section","class":"hv-homepage","settings":[{"type":"image_picker","id":"hero_image","label":"Ảnh hero — quản trị lựa chọn"},{"type":"text","id":"kicker","label":"Dòng nhấn","default":"THE HOUSE OF EXCEPTIONAL CRAFT"},{"type":"text","id":"heading","label":"Tiêu đề hero","default":"Thủ nghệ đáng được lưu truyền."},{"type":"textarea","id":"intro","label":"Mô tả hero","default":"Được tạo nên từ lửa, chất liệu và thời gian. Để truyền lại cho thế hệ mai sau."},{"type":"text","id":"primary_label","label":"Nút chính","default":"Khám phá bộ sưu tập"},{"type":"url","id":"primary_link","label":"Liên kết nút chính"},{"type":"text","id":"secondary_label","label":"Nút phụ","default":"Chế tác riêng"},{"type":"url","id":"secondary_link","label":"Liên kết nút phụ"},{"type":"text","id":"collections_heading","label":"Tiêu đề bộ sưu tập","default":"Bộ sưu tập nổi bật"},{"type":"header","content":"Chế tác riêng"},{"type":"image_picker","id":"bespoke_image","label":"Ảnh chế tác riêng"},{"type":"text","id":"bespoke_kicker","label":"Dòng nhấn","default":"BESPOKE & PRIVATE COMMISSION"},{"type":"text","id":"bespoke_heading","label":"Tiêu đề","default":"Dành riêng cho bạn. Tạo nên để trường tồn."},{"type":"textarea","id":"bespoke_copy","label":"Mô tả","default":"Từ cuộc trò chuyện đầu tiên đến từng chi tiết hoàn thiện, chúng tôi tạo nên tác phẩm độc bản mang câu chuyện của riêng bạn."},{"type":"text","id":"bespoke_label","label":"Nút","default":"Khám phá chế tác riêng"},{"type":"url","id":"bespoke_link","label":"Liên kết"},{"type":"text","id":"artisan_heading","label":"Tiêu đề nghệ nhân","default":"Tinh hoa nằm trong đôi tay"},{"type":"textarea","id":"artisan_copy","label":"Mô tả nghệ nhân","default":"Gặp gỡ những người gìn giữ tinh hoa thủ công Việt."},{"type":"url","id":"artisan_link","label":"Liên kết nghệ nhân"},{"type":"text","id":"journal_heading","label":"Tiêu đề Journal","default":"Câu chuyện về nghệ thuật, văn hóa và cảm hứng"},{"type":"textarea","id":"journal_copy","label":"Mô tả Journal","default":"Khám phá những câu chuyện phía sau từng tác phẩm."},{"type":"url","id":"journal_link","label":"Liên kết Journal"},{"type":"text","id":"newsletter_heading","label":"Tiêu đề newsletter","default":"Những câu chuyện trong hộp thư của bạn"},{"type":"textarea","id":"newsletter_copy","label":"Mô tả newsletter","default":"Nhận tin mới về thủ nghệ, tác phẩm và các đợt chế tác riêng."}],"blocks":[{"type":"trust","name":"Dấu hiệu tin cậy","limit":4,"settings":[{"type":"text","id":"title","label":"Tiêu đề","default":"Chế tác thủ công"},{"type":"text","id":"copy","label":"Mô tả","default":"Bởi nghệ nhân Việt"}]},{"type":"collection","name":"Thẻ bộ sưu tập","limit":4,"settings":[{"type":"collection","id":"collection","label":"Bộ sưu tập"},{"type":"image_picker","id":"image","label":"Ảnh thay thế"},{"type":"text","id":"eyebrow","label":"Dòng nhấn","default":"HA VAN"},{"type":"text","id":"title","label":"Tiêu đề","default":"Phụ kiện"},{"type":"textarea","id":"copy","label":"Mô tả","default":"Tinh xảo trong từng chi tiết."}]}],"presets":[{"name":"HA VAN — Homepage"}]}{% endschema %}