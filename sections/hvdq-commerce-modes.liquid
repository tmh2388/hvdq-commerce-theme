{% liquid
  assign visible_blocks = section.blocks | where: 'type', 'mode'
%}

{% if visible_blocks.size > 0 %}
  <section class="hvdq-modes" {{ section.shopify_attributes }}>
    {% if section.settings.heading != blank %}
      <h2 class="hvdq-modes__heading">{{ section.settings.heading | escape }}</h2>
    {% endif %}

    <div class="hvdq-modes__grid" style="--hvdq-modes-count: {{ visible_blocks.size }};">
      {% for block in visible_blocks %}
        {% liquid
          assign has_image = false
          if block.settings.image != blank
            assign has_image = true
          endif
          assign mode_alt = block.settings.image_alt
          if mode_alt == blank and has_image
            assign mode_alt = block.settings.image.alt
          endif
        %}
        <article
          class="hvdq-mode hvdq-mode--{{ block.settings.tone }}"
          {{ block.shopify_attributes }}
        >
          {% if has_image %}
            <img
              srcset="
                {{ block.settings.image | image_url: width: 400 }} 400w,
                {{ block.settings.image | image_url: width: 700 }} 700w,
                {{ block.settings.image | image_url: width: 1000 }} 1000w
              "
              sizes="(min-width: 750px) 33vw, 90vw"
              src="{{ block.settings.image | image_url: width: 700 }}"
              alt="{{ mode_alt | escape }}"
              width="{{ block.settings.image.width }}"
              height="{{ block.settings.image.height }}"
              loading="lazy"
              class="hvdq-mode__image"
            >
          {% endif %}
          <div class="hvdq-mode__content">
            {% if block.settings.title != blank %}
              <h3 class="hvdq-mode__title">{{ block.settings.title | escape }}</h3>
            {% endif %}
            {% if block.settings.subtitle != blank %}
              <p class="hvdq-mode__subtitle">{{ block.settings.subtitle | escape }}</p>
            {% endif %}
            {% if block.settings.body != blank %}
              <div class="hvdq-mode__body">{{ block.settings.body }}</div>
            {% endif %}
            {% if block.settings.link_label != blank and block.settings.link_url != blank %}
              <a href="{{ block.settings.link_url }}" class="hvdq-mode__link">
                {{- block.settings.link_label | escape -}}
              </a>
            {% endif %}
          </div>
        </article>
      {% endfor %}
    </div>
  </section>
{% endif %}

{% schema %}
{
  "name": "t:names.hvdq_commerce_modes",
  "tag": "section",
  "class": "hvdq-section",
  "max_blocks": 3,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.hvdq_heading"
    }
  ],
  "blocks": [
    {
      "type": "mode",
      "name": "t:names.hvdq_commerce_mode",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "t:settings.hvdq_title"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "t:settings.hvdq_subtitle"
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "t:settings.hvdq_body"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:settings.hvdq_image"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "t:settings.hvdq_image_alt",
          "info": "t:info.hvdq_image_alt"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "t:settings.hvdq_link_label"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "t:settings.hvdq_link_url"
        },
        {
          "type": "select",
          "id": "tone",
          "label": "t:settings.hvdq_tone",
          "options": [
            { "value": "light", "label": "t:options.hvdq_tone_light" },
            { "value": "dark", "label": "t:options.hvdq_tone_dark" }
          ],
          "default": "light"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:names.hvdq_commerce_modes",
      "blocks": [
        { "type": "mode", "settings": { "title": "Ready to Ship", "tone": "light" } },
        { "type": "mode", "settings": { "title": "Made to Order", "tone": "light" } },
        { "type": "mode", "settings": { "title": "Bespoke", "tone": "dark" } }
      ]
    }
  ]
}
{% endschema %}
