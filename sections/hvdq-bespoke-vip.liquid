{% liquid
  assign has_portrait = false
  if section.settings.portrait != blank
    assign has_portrait = true
  endif

  assign portrait_alt = section.settings.portrait_alt
  if portrait_alt == blank and has_portrait
    assign portrait_alt = section.settings.portrait.alt
  endif
  if portrait_alt == blank
    assign portrait_alt = section.settings.consultant_name
  endif

  assign benefit_blocks = section.blocks | where: 'type', 'benefit'
%}

<section class="hvdq-bespoke" {{ section.shopify_attributes }}>
  <div class="hvdq-bespoke__content">
    {% if section.settings.eyebrow != blank %}
      <p class="hvdq-bespoke__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {% endif %}

    {% if section.settings.heading != blank %}
      <h2 class="hvdq-bespoke__heading">{{ section.settings.heading | escape }}</h2>
    {% endif %}

    {% if section.settings.richtext_body != blank %}
      <div class="hvdq-bespoke__body">{{ section.settings.richtext_body }}</div>
    {% endif %}

    {% if benefit_blocks.size > 0 %}
      <ul class="hvdq-bespoke__benefits" role="list">
        {% for block in benefit_blocks %}
          {% if block.settings.text != blank %}
            <li class="hvdq-bespoke__benefit" {{ block.shopify_attributes }}>
              {{ block.settings.text | escape }}
            </li>
          {% endif %}
        {% endfor %}
      </ul>
    {% endif %}

    {% if section.settings.consultant_name != blank %}
      <p class="hvdq-bespoke__attribution">
        <span class="hvdq-bespoke__name">{{ section.settings.consultant_name | escape }}</span>
        {% if section.settings.consultant_role != blank %}
          <span class="hvdq-bespoke__role">{{ section.settings.consultant_role | escape }}</span>
        {% endif %}
      </p>
    {% endif %}

    {% if section.settings.button_label != blank and section.settings.button_url != blank %}
      <a href="{{ section.settings.button_url }}" class="button">
        {{- section.settings.button_label | escape -}}
      </a>
    {% endif %}
  </div>

  <div class="hvdq-bespoke__media">
    {% if has_portrait %}
      <img
        srcset="
          {{ section.settings.portrait | image_url: width: 500 }} 500w,
          {{ section.settings.portrait | image_url: width: 800 }} 800w,
          {{ section.settings.portrait | image_url: width: 1200 }} 1200w
        "
        sizes="(min-width: 750px) 40vw, 90vw"
        src="{{ section.settings.portrait | image_url: width: 800 }}"
        alt="{{ portrait_alt | escape }}"
        width="{{ section.settings.portrait.width }}"
        height="{{ section.settings.portrait.height }}"
        loading="lazy"
        class="hvdq-bespoke__image"
      >
    {% else %}
      <div class="hvdq-bespoke__placeholder" role="img" aria-label="{{ 'hvdq.bespoke.placeholder_alt' | t }}">
        {{ 'lifestyle' | placeholder_svg_tag: 'hvdq-bespoke__placeholder-svg' }}
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "t:names.hvdq_bespoke_vip",
  "tag": "section",
  "class": "hvdq-section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:settings.hvdq_eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.hvdq_heading",
      "default": "Cá nhân hóa & biểu tượng văn hóa"
    },
    {
      "type": "richtext",
      "id": "richtext_body",
      "label": "t:settings.hvdq_body"
    },
    {
      "type": "header",
      "content": "t:content.hvdq_media"
    },
    {
      "type": "image_picker",
      "id": "portrait",
      "label": "t:settings.hvdq_portrait"
    },
    {
      "type": "text",
      "id": "portrait_alt",
      "label": "t:settings.hvdq_image_alt",
      "info": "t:info.hvdq_image_alt"
    },
    {
      "type": "header",
      "content": "t:content.hvdq_attribution"
    },
    {
      "type": "text",
      "id": "consultant_name",
      "label": "t:settings.hvdq_consultant_name",
      "default": "Hạ Vân Minh"
    },
    {
      "type": "text",
      "id": "consultant_role",
      "label": "t:settings.hvdq_consultant_role"
    },
    {
      "type": "header",
      "content": "t:content.hvdq_actions"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:settings.hvdq_button_label"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "t:settings.hvdq_button_url"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "t:names.hvdq_benefit",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "t:settings.hvdq_benefit_text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:names.hvdq_bespoke_vip",
      "settings": {
        "eyebrow": "HVDQ",
        "heading": "Cá nhân hóa & biểu tượng văn hóa",
        "consultant_name": "Hạ Vân Minh"
      }
    }
  ]
}
{% endschema %}
