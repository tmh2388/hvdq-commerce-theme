{% liquid
  assign visible_blocks = section.blocks | where: 'type', 'technique'
%}

{% if visible_blocks.size > 0 %}
  <section class="hvdq-techniques" {{ section.shopify_attributes }}>
    {% if section.settings.heading != blank %}
      <h2 class="hvdq-techniques__heading">{{ section.settings.heading | escape }}</h2>
    {% endif %}

    <ul class="hvdq-techniques__grid" role="list">
      {% for block in visible_blocks %}
        {% liquid
          assign has_image = false
          if block.settings.image != blank
            assign has_image = true
          endif
          assign technique_alt = block.settings.image_alt
          if technique_alt == blank and has_image
            assign technique_alt = block.settings.image.alt
          endif
        %}
        <li class="hvdq-technique" {{ block.shopify_attributes }}>
          {% if block.settings.link_url != blank %}
            <a href="{{ block.settings.link_url }}" class="hvdq-technique__link">
          {% endif %}
            <span class="hvdq-technique__media">
              {% if has_image %}
                <img
                  srcset="
                    {{ block.settings.image | image_url: width: 400 }} 400w,
                    {{ block.settings.image | image_url: width: 700 }} 700w
                  "
                  sizes="(min-width: 750px) 30vw, 45vw"
                  src="{{ block.settings.image | image_url: width: 700 }}"
                  alt="{{ technique_alt | escape }}"
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.height }}"
                  loading="lazy"
                  class="hvdq-technique__image"
                >
              {% else %}
                <span class="hvdq-technique__placeholder" aria-hidden="true">
                  {{ 'image' | placeholder_svg_tag: 'hvdq-technique__placeholder-svg' }}
                </span>
              {% endif %}
            </span>
            <span class="hvdq-technique__content">
              {% if block.settings.title != blank %}
                <span class="hvdq-technique__title">{{ block.settings.title | escape }}</span>
              {% endif %}
              {% if block.settings.international_name != blank %}
                <span class="hvdq-technique__international-name">
                  {{- block.settings.international_name | escape -}}
                </span>
              {% endif %}
              {% if block.settings.short_description != blank %}
                <span class="hvdq-technique__description">{{ block.settings.short_description | escape }}</span>
              {% endif %}
            </span>
          {% if block.settings.link_url != blank %}
            </a>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  </section>
{% endif %}

{% schema %}
{
  "name": "t:names.hvdq_craft_techniques",
  "tag": "section",
  "class": "hvdq-section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.hvdq_heading"
    }
  ],
  "blocks": [
    {
      "type": "technique",
      "name": "t:names.hvdq_technique",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:settings.hvdq_image"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "t:settings.hvdq_image_alt",
          "info": "t:info.hvdq_image_alt"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:settings.hvdq_title"
        },
        {
          "type": "text",
          "id": "international_name",
          "label": "t:settings.hvdq_international_name"
        },
        {
          "type": "textarea",
          "id": "short_description",
          "label": "t:settings.hvdq_short_description"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "t:settings.hvdq_link_url"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:names.hvdq_craft_techniques",
      "blocks": [
        { "type": "technique" },
        { "type": "technique" },
        { "type": "technique" }
      ]
    }
  ]
}
{% endschema %}
