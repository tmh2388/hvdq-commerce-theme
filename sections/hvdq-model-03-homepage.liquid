{% liquid
 assign is_en = false
 if localization.language.iso_code == 'en'
  assign is_en = true
 endif
 assign handles = 'hvdq-test-blue-mountain-cufflinks,hvdq-test-nocturne-eclat,hvdq-test-lotus-harmony,hvdq-test-imperial-dragon' | split: ','
%}
<div class="hv" data-ha-van>
<header class="hv__header">
 <a class="hv__brand" href="{{ routes.root_url }}" aria-label="HA VAN — The House of Exceptional Craft"><picture><source media="(max-width: 480px)" srcset="https://cdn.shopify.com/s/files/1/0722/3030/5871/files/ha-van-monogram-balance-transparent.png?v=1784193250"><img src="https://cdn.shopify.com/s/files/1/0722/3030/5871/files/ha-van-header-logo-transparent.png?v=1784193226" alt="HA VAN — The House of Exceptional Craft" width="520" height="120" fetchpriority="high"></picture></a>
 <button class="hv__menu" type="button" aria-expanded="false">Menu</button>
 <nav class="hv__nav"><a href="/collections">{% if is_en %}Collections{% else %}Bộ sưu tập{% endif %}</a><a href="/pages/houses">{% if is_en %}Houses{% else %}Nhà chế tác{% endif %}</a><a href="/pages/makers">{% if is_en %}Makers{% else %}Nghệ nhân{% endif %}</a><a href="/blogs/journal">Journal</a><a href="/pages/archive">Archive</a><a href="/pages/commission">{% if is_en %}Commission{% else %}Chế tác riêng{% endif %}</a><a href="{{ routes.search_url }}">⌕</a><a href="{{ routes.cart_url }}">Bag · {{ cart.item_count }}</a></nav>
</header>
<main>
<section class="hv__hero"><div class="hv__hero-copy"><p class="hv__eyebrow">THE HOUSE OF EXCEPTIONAL CRAFT</p><h1>{% if is_en %}Craft worth preserving.{% else %}Thủ nghệ đáng được lưu truyền.{% endif %}</h1><p>{% if is_en %}A Vietnamese house selecting, commissioning and preserving exceptional objects shaped by fire, material and time.{% else %}HA VAN tuyển chọn, bảo chứng và kiến tạo những tác phẩm thủ nghệ xuất sắc—được hình thành qua lửa, chất liệu và thời gian.{% endif %}</p><div><a class="hv__button hv__button--dark" href="/collections/phụ-kiện-nam">{% if is_en %}Explore collections{% else %}Khám phá bộ sưu tập{% endif %}</a><a class="hv__button" href="/pages/commission">{% if is_en %}Private commission{% else %}Đặt chế tác riêng{% endif %}</a></div></div><div class="hv__hero-image" style="background-image:url('{{ 'hvdq-demo-products.png' | asset_url }}')"></div></section>
<section class="hv__philosophy"><span>Born from Fire.</span><span>Refined by Craft.</span><span>Preserved through Time.</span></section>
<section class="hv__selection" id="archive"><div class="hv__section-head"><div><p class="hv__eyebrow">{% if is_en %}THE CURRENT SELECTION{% else %}TUYỂN CHỌN HIỆN TẠI{% endif %}</p><h2>{% if is_en %}Objects of distinction{% else %}Những tác phẩm khác biệt{% endif %}</h2></div><a href="/collections/all">{% if is_en %}View all{% else %}Xem tất cả{% endif %} →</a></div><div class="hv__grid">{% for handle in handles %}{% assign product = all_products[handle] %}{% if product != blank %}<a class="hv__card" href="{{ product.url }}"><div class="hv__card-media">{% if product.featured_image %}{{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: product.title }}{% endif %}</div><small>HA VAN · {% if forloop.last %}COMMISSION{% else %}SELECTION{% endif %}</small><h3>{{ product.title }}</h3><p>{{ product.price | money_with_currency }}</p></a>{% endif %}{% endfor %}</div></section>
<section class="hv__house" id="house"><div class="hv__seal"><img src="https://cdn.shopify.com/s/files/1/0722/3030/5871/files/ha-van-heritage-seal.png?v=1784189871" alt="HA VAN Heritage Seal" width="480" height="480" loading="lazy"></div><div class="hv__house-copy" id="makers"><p class="hv__eyebrow">{% if is_en %}THE MASTER HOUSE{% else %}NHÀ THỦ NGHỆ{% endif %}</p><h2>{% if is_en %}A house built around makers, not mass production.{% else %}Một nhà thủ nghệ được xây quanh nghệ nhân, không quanh sản xuất đại trà.{% endif %}</h2><p>{% if is_en %}Each object preserves the identity of its maker, material and technique, while carrying the house standard of provenance and care.{% else %}Mỗi tác phẩm giữ nguyên danh tính nghệ nhân, chất liệu và kỹ nghệ; đồng thời mang chuẩn bảo chứng, nguồn gốc và chăm sóc của HA VAN.{% endif %}</p><a href="/pages/dang-huong-quynh">{% if is_en %}Meet the maker{% else %}Gặp nghệ nhân Đặng Hương Quỳnh{% endif %} →</a></div></section>
<section class="hv__commission"><p class="hv__eyebrow">PRIVATE COMMISSION</p><h2>{% if is_en %}An object made around your story.{% else %}Một tác phẩm được tạo nên quanh câu chuyện của riêng bạn.{% endif %}</h2><p>{% if is_en %}From enamel watches to executive accessories, commissions begin with material, meaning and the hand of the maker.{% else %}Từ đồng hồ pháp lam đến phụ kiện doanh nhân, mỗi đơn chế tác riêng bắt đầu từ chất liệu, ý nghĩa và đôi tay nghệ nhân.{% endif %}</p><a class="hv__button hv__button--dark" href="/pages/commission">{% if is_en %}Begin a commission{% else %}Bắt đầu chế tác riêng{% endif %}</a></section>
</main>
<footer class="hv__footer"><a class="hv__footer-brand" href="{{ routes.root_url }}" aria-label="HA VAN — The House of Exceptional Craft">{{ images['ha-van-footer-logo-final-transparent.png'] | image_url: width: 1600 | image_tag: widths: '480, 720, 960, 1280, 1600', sizes: '(max-width: 749px) 90vw, 680px', loading: 'lazy', alt: 'HA VAN — The House of Exceptional Craft' }}</a><div><strong>{% if is_en %}Client care{% else %}Chăm sóc khách hàng{% endif %}</strong><a href="/pages/huong-dan-thanh-toan">{% if is_en %}Payment{% else %}Thanh toán{% endif %}</a><a href="/pages/chinh-sach-van-chuyen">{% if is_en %}Shipping{% else %}Vận chuyển{% endif %}</a><a href="/pages/craft-care">Craft Passport</a><a href="/pages/chinh-sach-bao-hanh">{% if is_en %}Warranty{% else %}Bảo hành{% endif %}</a></div><div><strong>{% if is_en %}The house{% else %}Về HA VAN{% endif %}</strong><a href="/pages/about-ha-van">{% if is_en %}About{% else %}Giới thiệu{% endif %}</a><a href="/blogs/journal">Journal</a><a href="/pages/contact">{% if is_en %}Contact{% else %}Liên hệ{% endif %}</a></div><div class="hv__domain">havancraft.vn</div></footer><div class="hv__legal">© {{ 'now' | date: '%Y' }} HA VAN · Craft worth preserving.</div>
<style>.hv__footer-brand{display:block;width:min(100%,680px);max-width:none;background:transparent}.hv__footer-brand img{display:block;width:100%;height:auto;max-width:100%;object-fit:contain;background:transparent}@media(max-width:749px){.hv__footer-brand{width:min(100%,420px)}}</style>
</div>
<script>(()=>{const r=document.querySelector('[data-ha-van]'),b=r?.querySelector('.hv__menu'),n=r?.querySelector('.hv__nav');b?.addEventListener('click',()=>{const o=n.classList.toggle('is-open');b.setAttribute('aria-expanded',String(o))})})();</script>
{% schema %}{"name":"HA VAN Homepage","tag":"section","class":"ha-van-homepage","settings":[],"presets":[{"name":"HA VAN Homepage"}]}{% endschema %}