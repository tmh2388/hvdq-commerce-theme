{% liquid
  assign is_en = false
  if localization.language.iso_code == 'en'
    assign is_en = true
  endif
  assign imperial = all_products['hvdq-test-imperial-dragon']
  assign lotus = all_products['hvdq-test-lotus-harmony']
  assign nocturne = all_products['hvdq-test-nocturne-eclat']
  assign cufflinks = all_products['hvdq-test-blue-mountain-cufflinks']
%}
<div id="hvdq-top" class="hvdq-home">
  <div class="hvdq-utility">
    <span>{% if is_en %}Complimentary nationwide shipping in Vietnam{% else %}Miễn phí vận chuyển toàn quốc{% endif %}</span>
    {% form 'localization', class: 'hvdq-language' %}
      <button name="locale_code" value="vi" type="submit"{% unless is_en %} class="active"{% endunless %}>VI</button><span>/</span><button name="locale_code" value="en" type="submit"{% if is_en %} class="active"{% endif %}>EN</button>
    {% endform %}
  </div>
  <div class="hvdq-sticky">
    <header class="hvdq-header">
      <a class="hvdq-logo" href="{{ routes.root_url }}"><strong>HVDQ</strong><small>Artisan Enamel Atelier</small></a>
      <button class="hvdq-menu-button" type="button" aria-expanded="false" aria-controls="HvdqNav">☰</button>
      <div class="hvdq-actions"><a href="{{ routes.search_url }}" aria-label="Search">⌕</a><a href="{{ routes.account_url }}" aria-label="Account">♙</a><a href="{{ routes.cart_url }}" aria-label="Cart">Bag{% if cart.item_count > 0 %} ({{ cart.item_count }}){% endif %}</a></div>
    </header>
    <nav id="HvdqNav" class="hvdq-nav">
      <a href="/collections/phụ-kiện-nam">{% if is_en %}Men's accessories{% else %}Phụ kiện nam{% endif %}</a>
      <a href="/collections/bespoke">Bespoke</a>
      <a href="/collections/dồng-hồ-phap-lam">{% if is_en %}Enamel watches{% else %}Đồng hồ Pháp Lam{% endif %}</a>
      <a href="#atelier">{% if is_en %}The atelier{% else %}Nghệ xưởng{% endif %}</a>
      <a href="/pages/contact">{% if is_en %}Contact{% else %}Liên hệ{% endif %}</a>
    </nav>
  </div>

  <main>
    <section class="hvdq-hero">
      <div class="hvdq-hero-copy">
        <p class="eyebrow">{% if is_en %}Vietnamese artisan enamel · Crafted in Hanoi{% else %}Pháp Lam thủ công Việt Nam · Chế tác tại Hà Nội{% endif %}</p>
        <h1>{% if is_en %}Distinctive objects for a lasting legacy.{% else %}Tuyệt tác thủ công cho dấu ấn trường tồn.{% endif %}</h1>
        <p>{% if is_en %}Champlevé and cloisonné watches and accessories, handcrafted by artisan Đặng Hương Quỳnh.{% else %}Đồng hồ và phụ kiện Champlevé, Cloisonné được nghệ nhân Đặng Hương Quỳnh chế tác thủ công.{% endif %}</p>
        <div class="hvdq-buttons"><a class="primary" href="/collections/phụ-kiện-nam">{% if is_en %}Shop men's accessories{% else %}Khám phá phụ kiện nam{% endif %}</a><a href="/collections/bespoke">{% if is_en %}Commission a bespoke piece{% else %}Đặt chế tác riêng{% endif %}</a></div>
      </div>
      <div class="hvdq-hero-image" style="background-image:url('{{ 'hvdq-demo-products.png' | asset_url }}')"></div>
    </section>

    <section class="hvdq-trust">
      <article><b>01</b><div><strong>{% if is_en %}Crafted in Vietnam{% else %}Chế tác tại Việt Nam{% endif %}</strong><small>{% if is_en %}By HVDQ artisans{% else %}Bởi nghệ nhân HVDQ{% endif %}</small></div></article>
      <article><b>02</b><div><strong>{% if is_en %}100% bank transfer{% else %}Chuyển khoản 100%{% endif %}</strong><small>{% if is_en %}QR payment supported{% else %}Hỗ trợ quét mã QR{% endif %}</small></div></article>
      <article><b>03</b><div><strong>{% if is_en %}Personal consultation{% else %}Tư vấn cá nhân{% endif %}</strong><small>{% if is_en %}For bespoke commissions{% else %}Dành cho chế tác riêng{% endif %}</small></div></article>
      <article><b>04</b><div><strong>{% if is_en %}Complimentary shipping{% else %}Miễn phí vận chuyển{% endif %}</strong><small>{% if is_en %}Nationwide in Vietnam{% else %}Toàn quốc Việt Nam{% endif %}</small></div></article>
    </section>

    <section class="hvdq-featured">
      <div class="section-title"><div><p class="eyebrow">{% if is_en %}Featured works{% else %}Tác phẩm tiêu biểu{% endif %}</p><h2>{% if is_en %}Selected by the atelier{% else %}Tuyển chọn từ nghệ xưởng{% endif %}</h2></div><a href="/collections/phụ-kiện-nam">{% if is_en %}View collection{% else %}Xem bộ sưu tập{% endif %} →</a></div>
      <div class="hvdq-grid">
        {% assign products = imperial | append: ',' %}
        <a class="product-card" href="{{ imperial.url }}"><div class="product-image p1" style="background-image:url('{{ 'hvdq-demo-products.png' | asset_url }}')"></div><h3>Imperial Dragon</h3><p>{% if is_en %}Bespoke enamel artwork{% else %}Tác phẩm Pháp Lam độc bản{% endif %}</p><strong>{{ imperial.price | money_with_currency }}</strong></a>
        <a class="product-card" href="{{ lotus.url }}"><div class="product-image p2" style="background-image:url('{{ 'hvdq-demo-products.png' | asset_url }}')"></div><h3>Lotus Harmony</h3><p>{% if is_en %}Cloisonné enamel watch{% else %}Đồng hồ men Cloisonné{% endif %}</p><strong>{{ lotus.price | money_with_currency }}</strong></a>
        <a class="product-card" href="{{ nocturne.url }}"><div class="product-image p3" style="background-image:url('{{ 'hvdq-demo-products.png' | asset_url }}')"></div><h3>Nocturne Éclat</h3><p>{% if is_en %}Champlevé enamel watch{% else %}Đồng hồ men Champlevé{% endif %}</p><strong>{{ nocturne.price | money_with_currency }}</strong></a>
        <a class="product-card" href="{{ cufflinks.url }}"><div class="product-image p4" style="background-image:url('{{ 'hvdq-demo-products.png' | asset_url }}')"></div><h3>Blue Mountain Cufflinks</h3><p>{% if is_en %}Cloisonné cufflinks{% else %}Khuy măng sét Cloisonné{% endif %}</p><strong>{{ cufflinks.price | money_with_currency }}</strong></a>
      </div>
    </section>

    <section id="atelier" class="hvdq-bespoke">
      <div class="bespoke-image" style="background-image:url('{{ 'hvdq-demo-products.png' | asset_url }}')"></div>
      <div><p class="eyebrow">Bespoke</p><h2>{% if is_en %}Your story, interpreted in enamel.{% else %}Câu chuyện của anh, được chuyển hóa thành Pháp Lam.{% endif %}</h2><p>{% if is_en %}Work directly with the atelier to shape the motif, materials and meaning of a one-of-one piece.{% else %}Làm việc trực tiếp cùng nghệ xưởng để định hình họa tiết, chất liệu và ý nghĩa cho một tác phẩm độc bản.{% endif %}</p><a class="primary" href="/collections/bespoke">{% if is_en %}Begin a commission{% else %}Bắt đầu chế tác riêng{% endif %}</a></div>
    </section>
  </main>

  <footer class="hvdq-footer">
    <div><strong class="footer-logo">HVDQ</strong><p>{% if is_en %}Vietnamese enamel artistry for a new generation.{% else %}Nghệ thuật Pháp Lam Việt Nam cho một thế hệ mới.{% endif %}</p></div>
    <div><strong>{% if is_en %}Shop{% else %}Mua sắm{% endif %}</strong><a href="/collections/phụ-kiện-nam">{% if is_en %}Men's accessories{% else %}Phụ kiện nam{% endif %}</a><a href="/collections/dồng-hồ-phap-lam">{% if is_en %}Enamel watches{% else %}Đồng hồ Pháp Lam{% endif %}</a><a href="/collections/bespoke">Bespoke</a></div>
    <div><strong>{% if is_en %}Client service{% else %}Dịch vụ khách hàng{% endif %}</strong><a href="/pages/huong-dan-thanh-toan">{% if is_en %}Payment guide{% else %}Hướng dẫn thanh toán{% endif %}</a><a href="/pages/contact">{% if is_en %}Contact{% else %}Liên hệ{% endif %}</a></div>
    <div><strong>{% if is_en %}Commitment{% else %}Cam kết{% endif %}</strong><span>{% if is_en %}Free nationwide shipping{% else %}Miễn phí vận chuyển toàn quốc{% endif %}</span><span>{% if is_en %}No cash on delivery{% else %}Không thanh toán COD{% endif %}</span></div>
  </footer>
  <div class="copyright">© {{ 'now' | date: '%Y' }} HVDQ · Hạ Vân Thủ Nghệ Bách Phẩm Đường</div>
  <a class="back-top" href="#hvdq-top" aria-label="Back to top">↑</a>
</div>
<script>
(() => { const root=document.querySelector('.hvdq-home'); if(!root)return; const btn=root.querySelector('.hvdq-menu-button'); const nav=root.querySelector('.hvdq-nav'); btn?.addEventListener('click',()=>{const open=nav.classList.toggle('open');btn.setAttribute('aria-expanded',String(open));}); nav?.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>nav.classList.remove('open'))); })();
</script>
{% stylesheet %}
html{scroll-behavior:smooth}.hvdq-home{--green:#0b704c;--dark:#123d2d;--ink:#171a17;--muted:#666a64;--line:#dedbd3;--ivory:#f7f5ef;width:100%;max-width:1600px;margin:auto;background:#fff;color:var(--ink);font-family:var(--font-body--family)}.hvdq-home *{box-sizing:border-box}.hvdq-home a{color:inherit;text-decoration:none}.hvdq-utility{display:flex;align-items:center;min-height:34px;padding:0 4vw;border-bottom:1px solid var(--line);font-size:11px}.hvdq-language{display:flex;gap:6px;margin-left:auto}.hvdq-language button{border:0;background:none;color:#888;cursor:pointer}.hvdq-language button.active{color:var(--ink);font-weight:700}.hvdq-sticky{position:sticky;z-index:40;top:0;background:rgba(255,255,255,.96);backdrop-filter:blur(12px);box-shadow:0 8px 24px rgba(19,45,34,.05)}.hvdq-header{display:flex;align-items:center;min-height:66px;padding:0 4vw;border-bottom:1px solid var(--line)}.hvdq-logo{display:flex;flex-direction:column;line-height:1}.hvdq-logo strong,.footer-logo{font-family:var(--font-heading--family);font-size:28px;letter-spacing:.06em}.hvdq-logo small{margin-top:5px;font-size:7px;letter-spacing:.14em;text-transform:uppercase}.hvdq-actions{display:flex;align-items:center;gap:20px;margin-left:auto;font-size:12px}.hvdq-actions a:first-child,.hvdq-actions a:nth-child(2){font-size:22px}.hvdq-menu-button{display:none;border:0;background:none;font-size:22px}.hvdq-nav{display:flex;align-items:center;gap:clamp(24px,3vw,46px);min-height:46px;padding:0 4vw;border-bottom:1px solid var(--line);font-size:12px}.hvdq-nav a:hover{color:var(--green)}.hvdq-hero{display:grid;grid-template-columns:.9fr 1.1fr;min-height:560px;background:var(--ivory)}.hvdq-hero-copy{display:flex;flex-direction:column;align-items:flex-start;justify-content:center;padding:clamp(48px,6vw,96px)}.eyebrow{margin:0 0 16px;color:#60766b;font-size:10px;letter-spacing:.12em;text-transform:uppercase}.hvdq-hero h1{max-width:12ch;margin:0;font-family:var(--font-heading--family);font-size:clamp(42px,4.5vw,68px);font-weight:500;line-height:1.02}.hvdq-hero-copy>p:not(.eyebrow){max-width:48ch;margin:24px 0;color:var(--muted)}.hvdq-buttons{display:flex;flex-wrap:wrap;gap:10px}.hvdq-buttons a,.hvdq-bespoke a{display:inline-flex;min-height:46px;align-items:center;justify-content:center;padding:0 22px;border:1px solid var(--green);font-size:12px;font-weight:650}.primary{background:var(--green)!important;color:#fff!important}.hvdq-hero-image{min-height:520px;background-repeat:no-repeat;background-position:center top;background-size:auto 183%}.hvdq-trust{display:grid;grid-template-columns:repeat(4,1fr);padding:22px 4vw;border-block:1px solid var(--line)}.hvdq-trust article{display:flex;align-items:center;justify-content:center;gap:14px;padding:4px 18px;border-right:1px solid var(--line)}.hvdq-trust article:last-child{border:0}.hvdq-trust b{color:var(--green);font-size:12px}.hvdq-trust strong,.hvdq-trust small{display:block}.hvdq-trust strong{font-size:12px}.hvdq-trust small{color:var(--muted);font-size:10px}.hvdq-featured{padding:clamp(54px,6vw,88px) 4vw}.section-title{display:flex;align-items:end;justify-content:space-between;margin-bottom:28px}.section-title h2{margin:0;font-family:var(--font-heading--family);font-size:34px;font-weight:500}.section-title>a{color:var(--green);font-size:12px}.hvdq-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:clamp(14px,1.6vw,26px)}.product-image{aspect-ratio:.91;background-repeat:no-repeat;background-position-y:97.3%;background-size:432% auto}.product-image.p1{background-position-x:1.6%}.product-image.p2{background-position-x:33.7%}.product-image.p3{background-position-x:66.4%}.product-image.p4{background-position-x:98.5%}.product-card h3{margin:14px 0 3px;font-family:var(--font-heading--family);font-size:17px}.product-card p{min-height:1.5em;margin:0 0 8px;color:var(--muted);font-size:11px}.product-card strong{font-size:13px}.hvdq-bespoke{display:grid;grid-template-columns:.9fr 1.1fr;margin:0 4vw 78px;background:#edf2eb}.bespoke-image{min-height:380px;background-repeat:no-repeat;background-position:68% top;background-size:auto 183%}.hvdq-bespoke>div:last-child{display:flex;flex-direction:column;align-items:flex-start;justify-content:center;padding:clamp(42px,5vw,76px)}.hvdq-bespoke h2{max-width:18ch;margin:0;font-family:var(--font-heading--family);font-size:clamp(34px,3.4vw,50px);font-weight:500;line-height:1.08}.hvdq-bespoke p:not(.eyebrow){max-width:48ch;margin:20px 0 28px;color:var(--muted)}.hvdq-footer{display:grid;grid-template-columns:1.5fr repeat(3,1fr);gap:38px;padding:58px 4vw;background:var(--dark);color:#edf2ee}.hvdq-footer>div{display:flex;flex-direction:column;gap:9px}.hvdq-footer strong{margin-bottom:6px;color:#fff}.hvdq-footer a,.hvdq-footer p,.hvdq-footer span{margin:0;color:#bdccc4;font-size:11px}.copyright{padding:15px 4vw;background:#0d2d20;color:#9fb3a9;font-size:10px}.back-top{position:fixed;z-index:60;right:20px;bottom:32px;display:grid;width:48px;height:48px;place-items:center;border-radius:50%;background:var(--green);color:#fff!important;box-shadow:0 10px 28px rgba(9,71,48,.24)}@media(max-width:900px){.hvdq-trust{grid-template-columns:repeat(2,1fr)}.hvdq-grid{grid-template-columns:repeat(2,1fr)}.hvdq-footer{grid-template-columns:repeat(2,1fr)}}@media(max-width:680px){.hvdq-utility{display:none}.hvdq-header{min-height:56px;padding:0 16px}.hvdq-logo strong{font-size:23px}.hvdq-logo small,.hvdq-actions a:nth-child(2){display:none}.hvdq-menu-button{display:block;order:3;margin-left:14px}.hvdq-actions{gap:14px}.hvdq-nav{position:absolute;top:100%;right:0;left:0;display:none;flex-direction:column;align-items:stretch;gap:0;padding:8px 16px 18px;background:#fff;box-shadow:0 18px 30px rgba(19,45,34,.12)}.hvdq-nav.open{display:flex}.hvdq-nav a{display:flex;min-height:48px;align-items:center;border-bottom:1px solid var(--line)}.hvdq-hero{position:relative;display:block;min-height:calc(100svh - 56px);overflow:hidden}.hvdq-hero-image{position:absolute;inset:0;min-height:0;background-position:56% top;background-size:auto 148%}.hvdq-hero-copy{position:absolute;z-index:2;inset:0;justify-content:flex-end;padding:50px 22px 34px;background:linear-gradient(180deg,transparent 35%,rgba(8,25,18,.12) 56%,rgba(8,25,18,.88) 100%);color:#fff}.hvdq-hero .eyebrow{color:#d9e8df}.hvdq-hero h1{font-size:clamp(36px,10vw,46px)}.hvdq-hero-copy>p:not(.eyebrow),.hvdq-buttons a:not(.primary){display:none}.hvdq-buttons .primary{background:#fff!important;color:var(--green)!important;border-color:#fff}.hvdq-trust{grid-template-columns:1fr;padding:0 16px}.hvdq-trust article{justify-content:flex-start;min-height:68px;border-right:0;border-bottom:1px solid var(--line)}.hvdq-featured{padding:52px 16px}.section-title{align-items:flex-start}.section-title h2{font-size:29px}.section-title>a{max-width:90px;text-align:right}.hvdq-grid{gap:16px 12px}.product-card h3{font-size:15px}.product-card p{min-height:3em}.hvdq-bespoke{grid-template-columns:1fr;margin:0}.bespoke-image{min-height:290px}.hvdq-footer{grid-template-columns:1fr 1fr;padding:48px 22px}.hvdq-footer>div:first-child{grid-column:1/-1}.back-top{bottom:24px}}
{% endstylesheet %}
{% schema %}{"name":"HVDQ Model 03 Homepage","tag":"section","class":"hvdq-model-03-section","settings":[],"presets":[{"name":"HVDQ Model 03 Homepage"}]}{% endschema %}