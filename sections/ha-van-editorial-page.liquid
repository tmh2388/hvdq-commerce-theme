{% liquid
 assign hero_image = section.settings.hero_image
 if hero_image == blank and collections['all'].products.first != blank
   assign hero_image = collections['all'].products.first.featured_image
 endif
%}<section class="hv-editorial-hero"><div class="hv-editorial-hero__media">{% if hero_image != blank %}{{ hero_image | image_url: width: 2200 | image_tag: widths: '750,1200,1700,2200', loading: 'eager', alt: section.settings.heading }}{% endif %}</div><div class="hv-shell hv-editorial-hero__copy"><div class="hv-kicker">{{ section.settings.kicker }}</div><h1>{{ section.settings.heading }}</h1><p>{{ section.settings.intro }}</p><div class="hv-actions"><a class="hv-button hv-button--primary" href="{{ section.settings.primary_link }}">{{ section.settings.primary_label }}</a>{% if section.settings.secondary_label != blank %}<a class="hv-button" style="color:#fff;border-color:#fff" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label }}</a>{% endif %}</div></div></section>{% if section.blocks.size > 0 %}<section class="hv-section"><div class="hv-shell"><h2 class="hv-section-title">{{ section.settings.process_heading }}</h2><div class="hv-process">{% for block in section.blocks %}<div class="hv-process__step" {{ block.shopify_attributes }}><div class="hv-process__number">0{{ forloop.index }}</div><h3>{{ block.settings.title }}</h3><p>{{ block.settings.copy }}</p></div>{% endfor %}</div></div></section>{% endif %}{% if page.content != blank %}<section class="hv-section" style="padding-top:20px"><div class="hv-shell hv-rte rte">{{ page.content }}</div></section>{% endif %}<section class="hv-section" style="padding-top:20px"><div class="hv-shell hv-dark-feature"><div class="hv-dark-feature__copy"><div class="hv-kicker">{{ section.settings.cta_kicker }}</div><h2>{{ section.settings.cta_heading }}</h2><p>{{ section.settings.cta_copy }}</p><div class="hv-actions"><a class="hv-button" style="color:#fff;border-color:#fff" href="{{ section.settings.primary_link }}">{{ section.settings.primary_label }}</a></div></div><div class="hv-dark-feature__media">{% if hero_image != blank %}{{ hero_image | image_url: width: 1600 | image_tag: widths: '640,960,1280,1600', loading: 'lazy', alt: section.settings.cta_heading }}{% endif %}</div></div></section>{% schema %}{"name":"HA VAN — Editorial Page","settings":[{"type":"image_picker","id":"hero_image","label":"Ảnh hero"},{"type":"text","id":"kicker","label":"Dòng nhấn","default":"PRIVATE COMMISSION"},{"type":"text","id":"heading","label":"Tiêu đề","default":"Private Commission / Chế tác riêng"},{"type":"textarea","id":"intro","label":"Giới thiệu","default":"Một tác phẩm độc bản, được lắng nghe, thấu hiểu và chế tác dành riêng cho bạn."},{"type":"text","id":"primary_label","label":"Nút chính","default":"Đặt lịch tư vấn"},{"type":"url","id":"primary_link","label":"Liên kết nút chính"},{"type":"text","id":"secondary_label","label":"Nút phụ","default":"Gửi yêu cầu"},{"type":"url","id":"secondary_link","label":"Liên kết nút phụ"},{"type":"text","id":"process_heading","label":"Tiêu đề quy trình","default":"The Private Commission Process"},{"type":"text","id":"cta_kicker","label":"CTA nhấn","default":"BEGIN YOUR CREATION"},{"type":"text","id":"cta_heading","label":"CTA tiêu đề","default":"Bắt đầu một tác phẩm duy nhất của riêng bạn."},{"type":"textarea","id":"cta_copy","label":"CTA mô tả","default":"Đặt lịch tư vấn hoặc gửi yêu cầu để bắt đầu."}],"blocks":[{"type":"step","name":"Bước quy trình","limit":5,"settings":[{"type":"text","id":"title","label":"Tiêu đề","default":"Consultation"},{"type":"textarea","id":"copy","label":"Mô tả","default":"Chúng tôi lắng nghe câu chuyện, nhu cầu và tầm nhìn của bạn."}]}],"presets":[{"name":"HA VAN — Editorial Page"}]}{% endschema %}