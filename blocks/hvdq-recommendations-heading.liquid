{% doc %}
  Renders the localized heading for the HVDQ product recommendations section.

  @example
  {% content_for 'block', type: 'hvdq-recommendations-heading', id: 'hvdq-recommendations-heading' %}
{% enddoc %}

{% liquid
  assign heading = 'You may also like'

  case localization.language.iso_code
    when 'vi'
      assign heading = 'Có thể bạn cũng yêu thích'
    when 'zh-CN', 'zh-TW', 'zh'
      assign heading = '您可能也喜欢'
  endcase
%}

<h2 class="hvdq-recommendations-heading" {{ block.shopify_attributes }}>
  {{ heading }}
</h2>

{% stylesheet %}
  .hvdq-recommendations-heading {
    width: fit-content;
    margin: 0;
    font-family: var(--font-primary--family);
    font-size: var(--font-h4--size);
    font-weight: var(--font-primary--weight);
    line-height: normal;
    text-wrap: pretty;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.header",
  "tag": null,
  "settings": [],
  "presets": [
    {
      "name": "t:names.header"
    }
  ]
}
{% endschema %}
