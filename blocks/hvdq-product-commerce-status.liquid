{% doc %}
  Renders the HVDQ commerce model and estimated lead time sourced from product metafields.

  @example
  {% content_for 'block', type: 'hvdq-product-commerce-status', id: 'hvdq-commerce-status' %}
{% enddoc %}

{% liquid
  assign product_resource = closest.product
  assign commerce_mode = product_resource.metafields.hvdq.commerce_mode.value
  assign lead_time_days = product_resource.metafields.hvdq.lead_time_days.value
  assign language_code = localization.language.iso_code
  assign ready_to_ship_label = 'Ready to ship'
  assign made_to_order_label = 'Made to order'
  assign bespoke_label = 'Bespoke'

  case language_code
    when 'vi'
      assign ready_to_ship_label = 'Hàng có sẵn'
      assign made_to_order_label = 'Đặt làm theo mẫu'
      assign bespoke_label = 'Chế tác riêng'
    when 'zh-CN', 'zh-TW', 'zh'
      assign ready_to_ship_label = '现货'
      assign made_to_order_label = '按款定制'
      assign bespoke_label = '专属定制'
  endcase

  capture commerce_mode_label
    case commerce_mode
      when 'READY_TO_SHIP'
        echo ready_to_ship_label
      when 'MADE_TO_ORDER'
        echo made_to_order_label
      when 'BESPOKE'
        echo bespoke_label
      else
        echo commerce_mode | escape
    endcase
  endcapture

  capture lead_time_label
    case language_code
      when 'vi'
        echo 'Thời gian dự kiến: '
        echo lead_time_days
        echo ' ngày'
      when 'zh-CN', 'zh-TW', 'zh'
        echo '预计制作时间：'
        echo lead_time_days
        echo ' 天'
      else
        echo 'Estimated lead time: '
        echo lead_time_days
        if lead_time_days == 1
          echo ' day'
        else
          echo ' days'
        endif
    endcase
  endcapture
%}

{% if commerce_mode != blank or lead_time_days != blank %}
  <div class="hvdq-product-status" {{ block.shopify_attributes }}>
    {% if commerce_mode != blank %}
      <span class="hvdq-product-status__mode">
        <span class="hvdq-product-status__dot" aria-hidden="true"></span>
        {{ commerce_mode_label | strip }}
      </span>
    {% endif %}

    {% if lead_time_days != blank %}
      <span class="hvdq-product-status__lead-time">
        {{ lead_time_label | strip }}
      </span>
    {% endif %}
  </div>
{% endif %}

{% stylesheet %}
  .hvdq-product-status {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--gap-xs) var(--gap-sm);
    width: 100%;
  }

  .hvdq-product-status__mode {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2rem;
    padding: 0.35rem 0.75rem;
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.2);
    border-radius: 999px;
    font-size: var(--font-paragraph-small--size);
    font-weight: 600;
    letter-spacing: 0.06em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .hvdq-product-status__dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--color-hvdq-accent-gold);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-hvdq-accent-gold) 18%, transparent);
  }

  .hvdq-product-status__lead-time {
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text));
    font-size: var(--font-paragraph-small--size);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.product_information",
  "tag": null,
  "settings": [],
  "presets": [
    {
      "name": "t:names.product_information"
    }
  ]
}
{% endschema %}
