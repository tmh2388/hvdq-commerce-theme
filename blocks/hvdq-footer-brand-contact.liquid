<div class="ha-van-footer-brand" {{ block.shopify_attributes }}>
  <a class="ha-van-footer-brand__logo" href="{{ routes.root_url }}" aria-label="HA VAN — The House of Exceptional Craft">
    {{ images['ha-van-footer-logo-final-transparent.png']
      | image_url: width: 1600
      | image_tag:
        widths: '480, 720, 960, 1280, 1600',
        sizes: '(max-width: 749px) 90vw, 680px',
        loading: 'lazy',
        alt: 'HA VAN — The House of Exceptional Craft'
    }}
  </a>
  <p>Born from Fire. Refined by Craft. Preserved through Time.</p>
  <a href="https://havancraft.vn">havancraft.vn</a>
</div>
{% stylesheet %}
.ha-van-footer-brand{display:grid;gap:14px}
.ha-van-footer-brand__logo{display:block;width:min(100%,680px);background:transparent}
.ha-van-footer-brand__logo img{display:block;width:100%;height:auto;object-fit:contain;background:transparent}
.ha-van-footer-brand p,.ha-van-footer-brand>a:not(.ha-van-footer-brand__logo){margin:0;font-size:12px}
@media(max-width:749px){.ha-van-footer-brand__logo{width:min(100%,420px)}}
{% endstylesheet %}
{% schema %}{"name":"HA VAN Brand","tag":null}{% endschema %}