<a class="hv-header-lockup" href="{{ routes.root_url }}" aria-label="HA VAN — The House of Exceptional Craft" {{ block.shopify_attributes }}>
  {{ images['ha-van-header-logo-transparent.png']
    | image_url: width: 720
    | image_tag:
      widths: '240, 360, 480, 600, 720',
      sizes: '(max-width: 749px) 72vw, 320px',
      loading: 'eager',
      fetchpriority: 'high',
      alt: 'HA VAN — The House of Exceptional Craft'
  }}
</a>
{% stylesheet %}
.hv-header-lockup{display:block;width:min(100%,320px)}
.hv-header-lockup img{display:block;width:100%;height:auto;object-fit:contain}
@media(max-width:749px){.hv-header-lockup{width:min(72vw,290px)}}
{% endstylesheet %}
{% schema %}{"name":"HA VAN Logo","tag":null}{% endschema %}